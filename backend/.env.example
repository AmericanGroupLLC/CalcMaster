# ──────────────────────────────────────────────
# CalcMaster Backend — Environment Configuration
# Copy to .env and fill in real values before production
# ──────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL) ───
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=calcmaster
DB_PASSWORD=calcmaster_dev
DB_NAME=calcmaster

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_base64_64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── OAuth: Google ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── OAuth: Apple ───
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── AI Providers (set at least one) ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-6

# ─── Firebase (push notifications) ───
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
