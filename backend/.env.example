# ──────────────────────────────────────────────────────────────────────────────
# CalcMaster Backend — Environment Configuration
# Copy to .env and fill in real values before deploying to production.
# All values marked REQUIRED must be set; optional values have safe defaults.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Public-facing API base URL (used in OAuth callbacks, emails, etc.)
API_BASE_URL=https://api.safecodeg.com

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# REQUIRED: Set to your managed PostgreSQL host (e.g. AWS RDS, Supabase, Neon)
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_USERNAME=calcmaster
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=calcmaster

# ─── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED: Set to your managed Redis host (e.g. AWS ElastiCache, Upstash)
REDIS_HOST=your-redis-host.example.com
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_base64_64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── OAuth: Google ────────────────────────────────────────────────────────────
# REQUIRED for Google Sign-In: console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.safecodeg.com/api/v1/auth/google/callback

# ─── OAuth: Apple ─────────────────────────────────────────────────────────────
# REQUIRED for Sign in with Apple: developer.apple.com → Certificates, IDs & Profiles
APPLE_CLIENT_ID=com.americangroupllc.calcmaster
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the full .p8 key contents (with newlines as \n)
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://api.safecodeg.com/api/v1/auth/apple/callback

# ─── AI Providers (set at least one) ──────────────────────────────────────────
# REQUIRED: At least one AI key must be set for the AI chat feature to work.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-6

# ─── Firebase (push notifications) ───────────────────────────────────────────
# REQUIRED for push notifications: console.firebase.google.com → Project settings → Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (web app, extension, etc.)
CORS_ORIGINS=https://www.safecodeg.com,https://www.www.safecodeg.com,chrome-extension://REPLACE_WITH_EXTENSION_ID
