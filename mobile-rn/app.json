{
  "expo": {
    "name": "CalMaster",
    "slug": "calmaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#37474F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.americangroupllc.calmaster"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#37474F"
      },
      "package": "com.americangroupllc.calmaster"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}