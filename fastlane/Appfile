# App identifiers for fastlane. Secrets stay in the environment (see fastlane/README.md).

app_identifier("com.americangroupllc.calcmaster")          # iOS bundle ID
apple_id(ENV["FASTLANE_APPLE_ID"])                         # Apple account email (optional with API key)
team_id(ENV["APPLE_TEAM_ID"] || "TLH7Z3G27A")              # American Group LLC — Developer Portal team ID
itc_team_id(ENV["ASC_TEAM_ID"])                            # App Store Connect team ID (optional)

for_platform :android do
  package_name("com.americangroupllc.calcmaster")
  json_key_file(ENV["PLAY_JSON_KEY_FILE"] || "fastlane/play-service-account.json")
end
