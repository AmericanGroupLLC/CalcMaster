# Fastlane — CalcMaster (com.americangroupllc.calcmaster)
#
# Auth is entirely env-driven so the same lanes run locally and in CI with no
# secrets in the repo. See fastlane/README.md + docs/GO_LIVE.md.
#
#   iOS:     ASC_KEY_CONTENT (base64 .p8), FASTLANE_APPLE_ID,
#            IOS_DIST_P12_BASE64 + IOS_DIST_P12_PASSWORD  (manual signing; cert+key)
#            (ASC_KEY_ID, ASC_ISSUER_ID, APPLE_TEAM_ID are defaulted below)
#   Android: PLAY_JSON_KEY_FILE (path to a Play service-account JSON)

require "base64"
require "tmpdir"

default_platform(:ios)

APP_ID = "com.americangroupllc.calcmaster".freeze
APP_NAME = "CalcMaster: World Calc".freeze
AAB_PATH = "../build/app/outputs/bundle/release/app-release.aab".freeze

# --- helpers ---------------------------------------------------------------

# App Store Connect API key — preferred over Apple-ID/password (no 2FA in CI).
# Key ID + Issuer ID are identifiers (not secrets) so they're defaulted here.
# ASC_KEY_CONTENT is the base64 .p8 private key — keep it a SECRET, never commit it.
def asc_api_key
  key_content = ENV["ASC_KEY_CONTENT"].to_s.strip
  if key_content.empty?
    UI.user_error!("ASC_KEY_CONTENT is empty. Set it (base64 of the App Store " \
      "Connect .p8 key) as a repo secret on the repository running this workflow.")
  end
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID", "Q9WLC6U37V"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID", "ec93cc91-97c2-4b03-860b-697d7ec5d1fb"),
    key_content: key_content,
    is_key_content_base64: true,
    in_house: false
  )
end

# Flutter names the IPA after the app, so don't hard-code the filename — pick
# the newest .ipa Flutter just produced.
def latest_ipa
  ipa = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa in build/ios/ipa — run the ios `build` lane first") if ipa.nil?
  ipa
end

def play_json_key
  ENV.fetch("PLAY_JSON_KEY_FILE", "fastlane/play-service-account.json")
end

# --- iOS -------------------------------------------------------------------

platform :ios do
  desc "Run the Flutter test suite"
  lane :test do
    sh("cd .. && flutter test")
  end

  desc "ONE-TIME: register the App ID + create the App Store Connect record"
  lane :bootstrap do
    # `produce` has no api_key: param — running the API-key action first stores
    # the key in the lane context, which produce (spaceship) then picks up.
    asc_api_key
    produce(
      app_identifier: APP_ID,
      app_name: APP_NAME,
      language: "en-US",
      app_version: "4.0.0",
      sku: "calcmaster-001"
      # No enable_services: App Tracking Transparency is an app-level framework
      # (Info.plist NSUserTrackingUsageDescription), not a registerable capability.
    )
  end

  desc "Build a signed App Store IPA via Flutter (manual signing)"
  lane :build do
    setup_ci if ENV["CI"] # ephemeral keychain on CI runners

    # Import the Apple Distribution cert + private key (.p12) so the machine can
    # sign. Only needed on CI — locally the cert is already in your Keychain.
    # Guard on a non-empty value: an empty secret would otherwise feed empty
    # bytes to import_certificate and fail with a cryptic SecKeychainItemImport.
    p12_b64 = ENV["IOS_DIST_P12_BASE64"].to_s.strip
    if ENV["CI"] && p12_b64.empty?
      UI.user_error!("IOS_DIST_P12_BASE64 is empty. Set it (base64 of the Apple " \
        "Distribution .p12) and IOS_DIST_P12_PASSWORD as repo secrets on the " \
        "repository running this workflow.")
    end
    unless p12_b64.empty?
      p12_path = File.join(Dir.tmpdir, "calcmaster-dist.p12")
      File.binwrite(p12_path, Base64.decode64(p12_b64))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV.fetch("IOS_DIST_P12_PASSWORD", ""),
        keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
        keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
      )
    end

    # Fetch/create the App Store provisioning profile via the API key and install it.
    get_provisioning_profile(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      force: true
    )

    # Point the Xcode project at the downloaded profile (manual signing).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "../ios/Runner.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID", "TLH7Z3G27A"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["Runner"]
    )
    # CFBundleVersion must be unique per version on App Store Connect, so let CI
    # pass a monotonic build number (GitHub run number). Falls back to pubspec
    # when BUILD_NUMBER is unset (e.g. local builds).
    build_number = ENV["BUILD_NUMBER"].to_s.strip
    flags = "--release --export-method app-store"
    flags += " --build-number=#{build_number}" unless build_number.empty?
    sh("cd .. && flutter build ipa #{flags}")
  end

  desc "Build + upload to TestFlight (works for the very first build too)"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: latest_ipa,
      skip_waiting_for_build_processing: true,
      groups: ["Internal Beta"]
    )
  end

  desc "Build + upload binary, metadata, screenshots, and submit for App Store review"
  lane :release do
    build
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      ipa: latest_ipa,
      submit_for_review: true,
      automatic_release: true,
      force: true, # skip the HTML metadata preview prompt
      precheck_include_in_app_purchases: false,
      # metadata + screenshots are read from fastlane/metadata and fastlane/screenshots
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_install: true,
        add_id_info_tracks_action: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false
      }
    )
  end
end

# --- Android ---------------------------------------------------------------

platform :android do
  desc "Build + upload the AAB + listing to the Play internal track"
  lane :beta do
    sh("cd .. && flutter build appbundle --release")
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      json_key: play_json_key,
      skip_upload_apk: true,
      metadata_path: "fastlane/metadata/android"
    )
  end

  desc "Build + upload the AAB + listing straight to production"
  lane :release do
    sh("cd .. && flutter build appbundle --release")
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      json_key: play_json_key,
      skip_upload_apk: true,
      release_status: "completed",
      metadata_path: "fastlane/metadata/android"
    )
  end

  desc "Promote the current internal build to production (no new binary)"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: play_json_key,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
