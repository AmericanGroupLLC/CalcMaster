<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>CalcMaster</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>CalcMaster</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.americangroupllc.calcmaster</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.americangroupllc.calcmaster</string>
			</array>
		</dict>
		<!-- Google Sign-In callback scheme is intentionally ABSENT.
		     Registering it requires the REVERSED_CLIENT_ID from the app's
		     GoogleService-Info.plist (form: com.googleusercontent.apps.NNNN-xxxx),
		     which this repo does not ship. A literal "REVERSED_CLIENT_ID"
		     placeholder used to be registered here — an invalid scheme that
		     could never receive a callback. Google Sign-In on iOS therefore
		     fails gracefully (AuthProvider.signInWithGoogle catches and reports
		     it); email/password, Apple Sign-In and guest mode are unaffected.
		     TO ENABLE: add GoogleService-Info.plist to ios/Runner/, then add a
		     dict here whose CFBundleURLSchemes is that REVERSED_CLIENT_ID. -->
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Google's PUBLIC SAMPLE AdMob app ID, not CalcMaster's.
	     google_mobile_ads crashes at launch if this key is missing or malformed,
	     so a valid placeholder must stay here. Because it is sample inventory,
	     AdService refuses to serve ads on iOS in release builds (see
	     MonetizationConfig.iosAdIdsAreReal) — iOS ships ad-free until the real
	     ID lands. TO ENABLE iOS ads: paste the real iOS app ID here AND the real
	     iOS unit IDs into MonetizationConfig, then add SKAdNetworkItems. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CalcMaster uses your location to detect your region and currency, and when you tap Use my location in the GPS Coordinates tool.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>CalcMaster uses tracking to show relevant ads and improve our service. You can opt out anytime.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
